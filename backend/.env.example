# Copia este archivo como .env y cambia la clave antes de enviar lecturas.
PORT=3001
HOST=0.0.0.0
DEVICE_API_KEY=cambia-esta-clave-larga-y-privada
DATA_DIR=./data
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Valores relativos de ejemplo; ajustarlos después de calibrar el MQ-5 y el LDR.
GAS_WARNING=35
GAS_DANGER=60
TEMP_WARNING=30
DARKNESS_THRESHOLD=30

# Opcional: bot de Telegram y chat que recibirá las alertas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_TIME_ZONE=America/El_Salvador
